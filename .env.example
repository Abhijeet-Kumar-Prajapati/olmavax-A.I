# ─────────────────────────────────────────────────────────────
# Olmavax A.I — environment template
# Copy this file to `.env` only if you want server-side keys.
#
# ⚠️ You do NOT need this file. Everything works with zero
#    configuration: API keys can be typed into Settings inside the
#    browser, where they stay in localStorage and are never written
#    to disk. Only use this file for headless / Docker / CI setups.
# ─────────────────────────────────────────────────────────────

# Server bind address. Keep 127.0.0.1 to stay local-only.
# Set 0.0.0.0 only if you understand the exposure risk.
HOST=127.0.0.1
PORT=8787

# Where chat history / memory / user facts are stored.
# OLMAVAX_DATA=./data

# ── Optional AI provider keys ─────────────────────────────────
# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI, or any OpenAI-compatible service (Groq, OpenRouter, LM Studio…)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Ollama — fully offline, no key needed.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Olmavax Agent sidecar (advanced Python agent) ───────────────
# Start it first:  python advanced/olmavax-agent/olmavax_agent.py ui
# OLMAVAX_AGENT_URL=http://127.0.0.1:8765
# OLMAVAX_AGENT_TIMEOUT=1500
